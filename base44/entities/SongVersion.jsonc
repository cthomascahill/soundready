{
  "name": "SongVersion",
  "type": "object",
  "properties": {
    "pipeline_song_id": {
      "type": "string",
      "description": "Tracker song this version belongs to"
    },
    "song_title": {
      "type": "string",
      "description": "Song title at time of upload (for search/display)"
    },
    "label": {
      "type": "string",
      "description": "Version label, e.g. Mix V1, Mix V2, Master V1, Final Master"
    },
    "file_uri": {
      "type": "string",
      "description": "Audio file in private storage"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the latest/current version of the song"
    }
  },
  "required": [
    "pipeline_song_id",
    "label",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}