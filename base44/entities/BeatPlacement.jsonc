{
  "name": "BeatPlacement",
  "type": "object",
  "properties": {
    "beat_id": {
      "type": "string",
      "description": "Reference to the Beat entity"
    },
    "beat_title": {
      "type": "string",
      "description": "Beat title at time of placement"
    },
    "artist_name": {
      "type": "string",
      "description": "Artist the beat was placed with"
    },
    "deal_type": {
      "type": "string",
      "enum": [
        "Lease",
        "Exclusive"
      ]
    },
    "fee": {
      "type": "number",
      "description": "Fee earned in USD"
    },
    "date": {
      "type": "string",
      "description": "ISO date of the placement"
    },
    "notes": {
      "type": "string",
      "description": "Notes about the placement"
    }
  },
  "required": [
    "artist_name",
    "deal_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}