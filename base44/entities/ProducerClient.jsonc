{
  "name": "ProducerClient",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Artist / client name"
    },
    "email": {
      "type": "string",
      "description": "Client contact email"
    },
    "sound": {
      "type": "string",
      "description": "Their genre / sound"
    },
    "stage": {
      "type": "string",
      "enum": [
        "Prospect",
        "Pitched",
        "Negotiating",
        "Closed"
      ],
      "default": "Prospect",
      "description": "Deal pipeline stage"
    },
    "source": {
      "type": "string",
      "enum": [
        "Manual",
        "Artist Match",
        "Contract",
        "Beat Store"
      ],
      "default": "Manual",
      "description": "How this client entered the pipeline"
    },
    "terms": {
      "type": "string",
      "description": "Negotiated terms (lease/exclusive, fee, splits...)"
    },
    "beat_title": {
      "type": "string",
      "description": "Beat this relationship is about, if any"
    },
    "last_contact_date": {
      "type": "string",
      "description": "ISO date of last contact"
    },
    "notes": {
      "type": "string",
      "description": "Follow-up notes"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}