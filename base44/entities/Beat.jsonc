{
  "name": "Beat",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "producer_name": {
      "type": "string"
    },
    "producer_email": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "mood_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "file_url": {
      "type": "string",
      "description": "Audio file \u2014 public URL or private file URI from UploadPrivateFile"
    },
    "for_sale": {
      "type": "boolean",
      "default": false,
      "description": "Listed for sale in the producer's public Beat Store"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "featured"
      ],
      "default": "pending"
    },
    "stage": {
      "type": "string",
      "enum": [
        "Idea",
        "Sketch",
        "Full Beat",
        "Mixed",
        "Sent Out",
        "Placed"
      ],
      "default": "Idea",
      "description": "Producer pipeline stage (Beat Pipeline)"
    },
    "notes": {
      "type": "string",
      "description": "Producer notes on this beat"
    },
    "lease_price": {
      "type": "number",
      "description": "Lease price in USD"
    },
    "exclusive_price": {
      "type": "number",
      "description": "Exclusive price in USD"
    },
    "placed_with_artist": {
      "type": "string",
      "description": "Artist the beat was placed with, once stage is Placed"
    },
    "featured_date": {
      "type": "string"
    },
    "play_count": {
      "type": "number",
      "default": 0
    },
    "saves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "producer_name",
    "file_url"
  ]
}