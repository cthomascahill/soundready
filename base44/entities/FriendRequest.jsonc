{
  "name": "FriendRequest",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string",
      "description": "User id of the sender"
    },
    "requester_name": {
      "type": "string",
      "description": "Display name of the sender at request time"
    },
    "recipient_id": {
      "type": "string",
      "description": "User id of the recipient"
    },
    "recipient_name": {
      "type": "string",
      "description": "Display name of the recipient at request time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "Requests are approved manually by the recipient"
    }
  },
  "required": [
    "requester_id",
    "recipient_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.requester_id": "{{user.id}}"
    },
    "update": {
      "data.recipient_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    }
  }
}