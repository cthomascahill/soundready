{
  "name": "EPK",
  "type": "object",
  "description": "The artist's saved Electronic Press Kit: bio, real numbers, social proof and a music link, plus the generated PDF in private storage. Sam finds the latest one in Storage and attaches it to outbound emails.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this kit belongs to"
    },
    "artist_name": {
      "type": "string",
      "description": "Artist name shown on the kit"
    },
    "tagline": {
      "type": "string",
      "description": "One-line hook under the artist name"
    },
    "one_liner": {
      "type": "string",
      "description": "One sentence saying who the artist is and what they do"
    },
    "bio": {
      "type": "string",
      "description": "Polished press-ready bio"
    },
    "location": {
      "type": "string",
      "description": "City, state"
    },
    "genre": {
      "type": "string",
      "description": "Primary genre"
    },
    "photo_url": {
      "type": "string",
      "description": "Artist photo shown on the kit"
    },
    "music_url": {
      "type": "string",
      "description": "Clickable link to the artist's music"
    },
    "contact_email": {
      "type": "string",
      "description": "Booking/contact email on the kit"
    },
    "phone": {
      "type": "string",
      "description": "Booking phone shown on the kit"
    },
    "website": {
      "type": "string",
      "description": "Artist website"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram handle"
    },
    "tiktok": {
      "type": "string",
      "description": "TikTok handle"
    },
    "youtube": {
      "type": "string",
      "description": "YouTube channel link"
    },
    "highlights": {
      "type": "string",
      "description": "Career highlights, one per line"
    },
    "notable_shows": {
      "type": "string",
      "description": "Notable shows and collaborations, one per line"
    },
    "monthly_listeners": {
      "type": "number",
      "description": "Monthly listeners reported on the kit"
    },
    "total_streams": {
      "type": "number",
      "description": "Total streams reported on the kit"
    },
    "followers": {
      "type": "number",
      "description": "Combined social followers reported on the kit"
    },
    "social_proof": {
      "type": "array",
      "description": "Proof points the artist added: press, milestones, engagement",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The proof point itself"
          },
          "source": {
            "type": "string",
            "description": "Where it comes from, e.g. Earmilk, Spotify for Artists"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "featured_songs": {
      "type": "array",
      "description": "Songs from the Vault featured on the kit",
      "items": {
        "type": "object",
        "properties": {
          "song_id": {
            "type": "string",
            "description": "SongVault song id"
          },
          "title": {
            "type": "string"
          },
          "genre": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "share_token": {
      "type": "string",
      "description": "Secret code in the public /epk/ share URL; empty when not shared"
    },
    "file_uri": {
      "type": "string",
      "description": "Generated EPK PDF in private storage; what Sam attaches to emails"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "true = this is the kit Sam attaches; saving a new kit turns older ones off"
    }
  },
  "required": [
    "user_id",
    "artist_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}