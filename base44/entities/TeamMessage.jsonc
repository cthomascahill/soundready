{
  "name": "TeamMessage",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "default": "general",
      "description": "Channel: '<name>|||<team owner email>' for team channels, or 'dm|||email1|||email2' (sorted) for direct messages"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "reply_to_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails allowed to read this message: the team owner plus roster for team channels, or the two people for DMs"
    }
  },
  "required": [
    "channel",
    "sender_email",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participants": "{{user.email}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}