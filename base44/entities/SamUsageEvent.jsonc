{
  "name": "SamUsageEvent",
  "type": "object",
  "description": "One fair-use accounting entry for any AI action: reserved before the action runs, settled to the actual workload after, or released when it fails or was refused. Units are an internal workload estimate, not a currency. Written only by backend functions (service role); users can read their own entries but never edit them.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this usage belongs to"
    },
    "task_id": {
      "type": "string",
      "description": "SamTask this usage was reserved for; for fixed-cost features a synthetic marker like 'recommendations-1728000000000'"
    },
    "feature": {
      "type": "string",
      "enum": [
        "research",
        "recommendations",
        "playlist_pitch",
        "epk",
        "tour_opportunities",
        "weekly_digest",
        "intel_feed",
        "deal_research",
        "deal_draft",
        "music_news",
        "tour_search",
        "intel_email"
      ],
      "default": "research",
      "description": "Which AI feature this usage was spent on"
    },
    "units": {
      "type": "number",
      "description": "Estimated workload units when reserved; actual workload units once settled"
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "released",
        "settled"
      ],
      "description": "reserved = held while the action runs, released = returned without running (failed or concurrent overrun), settled = action finished and the actual workload is recorded"
    },
    "covered_by": {
      "type": "string",
      "enum": [
        "included",
        "addon"
      ],
      "description": "Whether these units draw from the monthly included allowance or from purchased extra usage"
    },
    "note": {
      "type": "string",
      "description": "Why the entry changed, e.g. estimate reserved, action complete (with AI call count), released on failure"
    }
  },
  "required": [
    "user_id",
    "task_id",
    "units",
    "status"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}