{
  "name": "ReleaseProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name, e.g. the album or EP title"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "Album",
        "EP"
      ],
      "default": "Album",
      "description": "Kind of release project"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this release project"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}