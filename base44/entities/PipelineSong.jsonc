{
  "name": "PipelineSong",
  "type": "object",
  "properties": {
    "song_name": {
      "type": "string",
      "description": "Song title"
    },
    "project_id": {
      "type": "string",
      "description": "ReleaseProject (Album/EP) this song belongs to; empty for Singles"
    },
    "stage_write": {
      "type": "boolean",
      "default": false
    },
    "stage_record": {
      "type": "boolean",
      "default": false
    },
    "stage_mix": {
      "type": "boolean",
      "default": false
    },
    "stage_master": {
      "type": "boolean",
      "default": false
    },
    "stage_review": {
      "type": "boolean",
      "default": false,
      "description": "Reviewing versions back and forth with the engineer"
    },
    "stage_artwork": {
      "type": "boolean",
      "default": false
    },
    "stage_submit": {
      "type": "boolean",
      "default": false
    },
    "stage_released": {
      "type": "boolean",
      "default": false,
      "description": "Song is out on streaming platforms"
    },
    "audio_file_uri": {
      "type": "string",
      "description": "Latest mix audio file in private storage"
    },
    "audio_version_label": {
      "type": "string",
      "description": "Label for the latest mix, e.g. MIX 5"
    },
    "artwork_file_uri": {
      "type": "string",
      "description": "Cover artwork file in private storage"
    },
    "release_date": {
      "type": "string",
      "description": "Planned release date (ISO date)"
    },
    "isrc_code": {
      "type": "string",
      "description": "ISRC code for the release, e.g. CC-XXX-YY-NNNNN"
    },
    "upc_code": {
      "type": "string",
      "description": "UPC / barcode for the release"
    },
    "notes": {
      "type": "string",
      "default": ""
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "song_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}