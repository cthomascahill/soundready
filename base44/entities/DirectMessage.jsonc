{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "User id of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender at send time"
    },
    "recipient_id": {
      "type": "string",
      "description": "User id of the recipient"
    },
    "recipient_name": {
      "type": "string",
      "description": "Display name of the recipient at send time"
    },
    "body": {
      "type": "string",
      "description": "Message text"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the recipient has opened it"
    }
  },
  "required": [
    "sender_id",
    "recipient_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.sender_id": "{{user.id}}"
    },
    "update": {
      "data.recipient_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    }
  }
}