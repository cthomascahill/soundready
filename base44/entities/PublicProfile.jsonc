{
  "name": "PublicProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this public profile belongs to"
    },
    "display_name": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "artist"
      ],
      "default": "artist"
    },
    "bio": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avatar_url": {
      "type": "string",
      "description": "Public avatar image URL"
    }
  },
  "required": [
    "user_id",
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}