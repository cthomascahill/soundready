{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email of the user who added this friend"
    },
    "friend_email": {
      "type": "string",
      "description": "Email of the friend"
    },
    "friend_name": {
      "type": "string",
      "description": "Display name of the friend"
    }
  },
  "required": [
    "owner_email",
    "friend_email"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}