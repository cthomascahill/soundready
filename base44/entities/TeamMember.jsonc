{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email of the team member"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "role_label": {
      "type": "string",
      "description": "Custom role e.g. Manager, Producer, Graphic Designer"
    },
    "invited_by": {
      "type": "string",
      "description": "Email of the account owner whose team this member belongs to"
    },
    "avatar_color": {
      "type": "string",
      "description": "Hex color for avatar"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}