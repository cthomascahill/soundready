{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "artist_name": {
      "type": "string",
      "description": "The artist's stage name"
    },
    "bio": {
      "type": "string",
      "description": "Artist bio or description"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Primary music genres"
    },
    "sub_genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sub-genres or specific styles"
    },
    "target_audience": {
      "type": "string",
      "description": "Primary target audience demographic"
    },
    "social_links": {
      "type": "object",
      "properties": {
        "spotify": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        },
        "twitter": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "soundcloud": {
          "type": "string"
        }
      },
      "description": "Social media profile links"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed initial onboarding"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "ai_manager"
      ],
      "default": "free",
      "description": "Current subscription tier"
    },
    "subscription_status": {
      "type": "string",
      "default": "none",
      "description": "Stripe subscription status: active, trialing, canceled, past_due, none"
    },
    "trial_ends_at": {
      "type": "string",
      "description": "ISO timestamp when the free trial ends and the card is charged"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false,
      "description": "Whether the subscription is set to cancel at period end"
    }
  },
  "required": [
    "role"
  ]
}