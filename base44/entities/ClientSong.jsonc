{
  "name": "ClientSong",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ClientProject this song belongs to"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Idea",
        "Recorded",
        "Mixed",
        "Mastered",
        "Delivered"
      ],
      "default": "Idea"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}