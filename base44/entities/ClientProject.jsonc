{
  "name": "ClientProject",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ProducerClient this project belongs to"
    },
    "title": {
      "type": "string",
      "description": "Project name, e.g. 'Summer EP'"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "In Progress",
        "Delivered",
        "On Hold"
      ],
      "default": "Planning"
    },
    "deadline": {
      "type": "string",
      "description": "ISO date the project is due"
    },
    "fee": {
      "type": "number",
      "description": "Project fee in USD"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}