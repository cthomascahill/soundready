{
  "name": "AIActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user this activity belongs to"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "playlist_pitch",
        "tour_opportunity",
        "epk_generated",
        "digest_sent",
        "booking_outreach",
        "producer_pitch",
        "beat_scout"
      ],
      "description": "Type of AI action taken"
    },
    "title": {
      "type": "string",
      "description": "Short title of the activity"
    },
    "description": {
      "type": "string",
      "description": "Full description of what the AI did"
    },
    "song_id": {
      "type": "string",
      "description": "Related song ID if applicable"
    },
    "song_title": {
      "type": "string",
      "description": "Related song or beat title"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "complete",
        "sent",
        "ready_to_send",
        "viewed",
        "denied"
      ],
      "default": "complete",
      "description": "pending/ready_to_send = awaiting artist approval, sent = approved & sent, denied = rejected by artist"
    },
    "draft_email": {
      "type": "string",
      "description": "Pre-drafted email ready to send"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email address the approved draft was sent to"
    },
    "sent_at": {
      "type": "string",
      "description": "ISO timestamp when the artist approved and the draft was sent"
    },
    "metadata": {
      "type": "object",
      "description": "Extra data like pitch count, opportunity details, etc."
    }
  },
  "required": [
    "user_id",
    "action_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}