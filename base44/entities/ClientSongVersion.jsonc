{
  "name": "ClientSongVersion",
  "type": "object",
  "properties": {
    "song_id": {
      "type": "string",
      "description": "ClientSong this version belongs to"
    },
    "label": {
      "type": "string",
      "description": "Version label, e.g. Mix V1, Master V2, Radio Edit"
    },
    "file_uri": {
      "type": "string",
      "description": "Audio file in private storage"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "Latest/current version of the song"
    }
  },
  "required": [
    "song_id",
    "label",
    "file_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}