{
  "name": "ContentProject",
  "type": "object",
  "properties": {
    "song_filename": {
      "type": "string"
    },
    "song_file_url": {
      "type": "string"
    },
    "vibe": {
      "type": "string",
      "enum": [
        "aggressive",
        "emotional",
        "confident",
        "storytelling"
      ]
    },
    "audio_analysis": {
      "type": "object"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "generating",
        "complete"
      ],
      "default": "complete"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this content project"
    }
  },
  "required": [
    "song_filename",
    "vibe"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}