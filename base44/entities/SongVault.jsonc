{
  "name": "SongVault",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "featured_artists": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "bpm": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "moods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Idea",
        "Demo",
        "Recorded",
        "Mixed",
        "Mastered",
        "Released"
      ],
      "default": "Released"
    },
    "release_date": {
      "type": "string"
    },
    "spotify_url": {
      "type": "string",
      "description": "Link to this song on Spotify. Sam uses this to pitch the released song to playlist curators."
    },
    "youtube_url": {
      "type": "string",
      "description": "Link to this song on YouTube"
    },
    "lyrics": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artwork_url": {
      "type": "string",
      "description": "Cover artwork image URL \u2014 displayed in the Vault library"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}