{
  "name": "ProducerContract",
  "type": "object",
  "properties": {
    "template_type": {
      "type": "string",
      "enum": [
        "beat_lease",
        "exclusive_rights",
        "collab_split",
        "nda"
      ],
      "description": "Which template agreement this contract is based on"
    },
    "producer_name": {
      "type": "string",
      "description": "Producer's legal or stage name"
    },
    "producer_email": {
      "type": "string",
      "description": "Producer's email (sender)"
    },
    "artist_name": {
      "type": "string",
      "description": "Artist the contract is with"
    },
    "artist_email": {
      "type": "string",
      "description": "Where the signing link was sent"
    },
    "beat_title": {
      "type": "string",
      "description": "Beat the agreement covers"
    },
    "deal_type": {
      "type": "string",
      "enum": [
        "Lease",
        "Exclusive"
      ]
    },
    "fee": {
      "type": "number",
      "description": "Fee in USD"
    },
    "terms": {
      "type": "string",
      "description": "The agreement terms body text"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "signed",
        "declined"
      ],
      "default": "draft",
      "description": "draft = not sent yet, sent = awaiting signature, signed = completed"
    },
    "share_token": {
      "type": "string",
      "description": "Secret token for the public signing link"
    },
    "sent_at": {
      "type": "string",
      "description": "ISO timestamp when the signing link was emailed"
    },
    "signed_at": {
      "type": "string",
      "description": "ISO timestamp when the artist e-signed"
    },
    "signed_name": {
      "type": "string",
      "description": "Typed name used as the artist's e-signature"
    },
    "pdf_file_uri": {
      "type": "string",
      "description": "Signed PDF stored in private file storage"
    }
  },
  "required": [
    "template_type",
    "producer_name",
    "artist_name"
  ]
}