{
  "name": "AI Manager Auto EPK Generation on Song Upload",
  "description": "When a new song analysis is completed, auto-generate an updated EPK for AI Manager tier artists.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"complete\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "SongAnalysis"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_manager_auto_epk_generation_on_song_upload",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "aiAutoEPK",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "aiAutoEPK"
  }
}